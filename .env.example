# Top-level .env — consumed by docker-compose.yml for ${VAR} substitution
# AND passed into the backend/frontend containers via env_file.
# Copy to .env and adjust before running `make docker-up`.

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=interview_coach
POSTGRES_USER=coach
POSTGRES_PASSWORD=coach_secret_change_me

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret_change_me

# ─── Whisper / faster-whisper ──────────────────────────────────────────────────
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ─── Piper ────────────────────────────────────────────────────────────────────
PIPER_VOICE=en_US-amy-medium

# ─── Embeddings (sentence-transformers, runs locally — no API key) ───────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── App secrets (also read directly by the backend container) ───────────────
SECRET_KEY=change_this_to_a_random_32_plus_character_secret_value
JWT_SECRET_KEY=change_this_to_a_different_random_32_plus_character_secret
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_32

# ─── OpenRouter (LLM) — get a free key at https://openrouter.ai/keys ─────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
