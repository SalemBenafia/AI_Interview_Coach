# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=AI Interview Coach
APP_ENV=development
DEBUG=true
SECRET_KEY=change_this_to_a_random_32_plus_character_secret_value
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_different_random_32_plus_character_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://coach:coach_secret@postgres:5432/interview_coach
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret_change_me
MINIO_BUCKET_RECORDINGS=interview-recordings
MINIO_BUCKET_REPORTS=interview-reports
MINIO_BUCKET_KNOWLEDGE=knowledge-uploads
MINIO_SECURE=false

# ─── Email (MailHog in dev) ────────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@interview-coach.ai

# ─── WebRTC — LiveKit + coturn ──────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_32
TURN_URL=turn:localhost:3478
TURN_USERNAME=coach
TURN_PASSWORD=coach_turn_secret

# ─── Agentic AI Engine — OpenRouter ──────────────────────────────────────────────
# Get a free key at https://openrouter.ai/keys (no credit card required).
# Free model IDs end in ":free" and rotate — check
# https://openrouter.ai/models?max_price=0 if the default below 404s.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=InterviewCoach

# ─── Speech Pipeline — Whisper + Piper ──────────────────────────────────────────
WHISPER_SERVICE_URL=http://stt-service:9001
WHISPER_MODEL=large-v3
PIPER_TTS_URL=http://tts-service:5002
PIPER_VOICE=en_US-amy-medium

# ─── Knowledge / RAG — Qdrant + all-MiniLM-L6-v2 ───────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=interview_knowledge
EMBEDDING_SERVICE_URL=http://embedding-service:8088

# ─── Signal Models — sentiment ─────────────────────────────────────────────────
SENTIMENT_SERVICE_URL=http://signal-service:8089

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
